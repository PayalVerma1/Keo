generator client {
  provider = "prisma-client-js"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model user {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  password      String?
  createdAt     DateTime  @default(now())
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  service       Service[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              user    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         user     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Service {
  id               String                 @id @default(uuid())
  name             String
  description      String?
  ownerID          String
  createdAt        DateTime               @default(now())
  deployment       Deployment[]
  insights         Insight[]
  logs             Logs[]
  metrics          Metrics[]
  owner            user                   @relation(fields: [ownerID], references: [id])
  baselines        VerificationBaseline[]
  verificationJobs VerificationJob[]      @relation("VerificationTargetService")
}

model VerificationJob {
  id                String              @id @default(uuid())
  status            VerificationStatus  @default(QUEUED)
  repository        String
  commitSha         String
  pullRequestNumber Int
  serviceId         String
  baselineServiceId String?
  startedAt         DateTime?
  completedAt       DateTime?
  thresholds        Json?
  metadata          Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  service           Service             @relation("VerificationTargetService", fields: [serviceId], references: [id])
  report            VerificationReport?

  @@index([status, createdAt])
  @@index([repository, pullRequestNumber])
}

model VerificationBaseline {
  id         String   @id @default(uuid())
  serviceId  String
  metrics    Json
  sampleSize Int
  capturedAt DateTime @default(now())
  service    Service  @relation(fields: [serviceId], references: [id])

  @@index([serviceId, capturedAt])
}

model VerificationReport {
  id              String             @id @default(uuid())
  jobId           String             @unique
  status          VerificationStatus
  summary         String
  comparisons     Json
  recommendations Json?
  createdAt       DateTime           @default(now())
  job             VerificationJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model Metrics {
  id                String   @id @default(uuid())
  cpu               Float
  memory            Float
  throughput        Float
  latency           Float
  errors            Float
  serviceId         String
  createdAt         DateTime @default(now())
  verificationJobId String?
  service           Service  @relation(fields: [serviceId], references: [id])

  @@index([serviceId, verificationJobId, createdAt])
}

model Logs {
  id        String   @id @default(uuid())
  level     String
  message   String
  serviceId String
  createdAt DateTime @default(now())
  service   Service  @relation(fields: [serviceId], references: [id])
}

model Deployment {
  id        String   @id @default(uuid())
  version   String
  serviceId String
  createdAt DateTime @default(now())
  service   Service  @relation(fields: [serviceId], references: [id])
}

model Insight {
  id             String   @id @default(uuid())
  severity       String
  rootCause      String
  recommendation String
  metricContext  Json?
  logContext     Json?
  serviceId      String
  createdAt      DateTime @default(now())
  service        Service  @relation(fields: [serviceId], references: [id])

  @@index([serviceId, createdAt])
}

enum VerificationStatus {
  QUEUED
  COLLECTING
  PROCESSING
  PASSED
  WARNING
  FAILED
  ERROR
}
